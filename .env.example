# Application database used by Prisma CLI commands and the Next.js server.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sectionly?schema=public"

# Dedicated disposable database used by PostgreSQL integration tests.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sectionly_test?schema=public"

# Generate with a cryptographically secure random value of at least 32 bytes.
AUTH_SECRET="replace-with-a-long-random-secret"

# Auth.js base URL. Set this to the deployed origin in production.
NEXTAUTH_URL="http://localhost:3000"
