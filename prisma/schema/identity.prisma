model User {
  id                    String    @id @default(uuid()) @db.Uuid
  fullName              String
  email                 String    @unique
  passwordHash          String
  role                  UserRole  @default(STUDENT)
  universityId          String?   @unique
  completedCreditHours  Int?
  isTransferredThisYear Boolean?
  locale                Locale    @default(EN)
  isActive              Boolean   @default(true)
  mustChangePassword    Boolean   @default(false)
  onboardingCompletedAt DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  courseAssignments     CourseAdmin[]       @relation("CourseAdminUser")
  courseEnrollments     CourseEnrollment[]  @relation("StudentEnrollments")
  authoredAnnouncements Announcement[]      @relation("AnnouncementAuthor")
  notifications         AdminNotification[] @relation("NotificationRecipient")
  auditLogs             AuditLog[]          @relation("AuditActor")
}
